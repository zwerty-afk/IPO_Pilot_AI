# Copy to server/.env for local development. On Vercel, set these in
# Project Settings → Environment Variables (never commit real values).

# ── AWS (DynamoDB + S3) ────────────────────────────────────────────────────
# The IAM user needs dynamodb:{Scan,GetItem,PutItem,DescribeTable} on the table
# and s3:{PutObject,GetObject,DeleteObject} on the bucket.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1
S3_BUCKET=ipo-pilot-ai-docs-2026
DYNAMO_TABLE=ipo_pilot_data

# Set to "false" to force the local db.json fallback instead of DynamoDB.
# USE_DYNAMO=false

# ── Gemini (OCR + draft generation) ────────────────────────────────────────
# Without a working key, uploaded documents report ocr_status=failed rather
# than inventing values.
GEMINI_API_KEY=your_gemini_key_here

# Optional. Defaults to gemini-flash-latest, which has a free-tier allowance and
# passes a PDF vision probe. Note gemini-2.0-flash returns 429 "limit: 0" on
# free-tier projects, and the 1.5-* models now 404 on v1beta.
# GEMINI_MODEL=gemini-flash-latest

# ── Session tokens ─────────────────────────────────────────────────────────
# Signs the HMAC session tokens issued at login/signup. REQUIRED in production:
# without it the server falls back to a random per-boot secret, which means every
# restart or redeploy silently logs everyone out, and multiple instances reject
# each other's tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate_a_long_random_string

# Optional. How long a session lasts before re-login is required (default 7 days).
# AUTH_TOKEN_TTL_MS=604800000

# ── Vercel Cron ────────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/sebi-refresh. Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_long_random_string

# ── Optional ───────────────────────────────────────────────────────────────
# Only needed if the backend is hosted separately from the frontend.
# VITE_API_BASE_URL=https://your-backend.example.com/api
PORT=3001
